APP_NAME=LuziCity
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://luzicity.com.br
APP_TIMEZONE=America/Sao_Paulo

LOG_CHANNEL=stack
LOG_STACK=daily,json
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=luzicity
DB_USERNAME=luzicity
DB_PASSWORD=

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

FILESYSTEM_DISK=s3
BACKUP_DISK=s3
BACKUP_RETENTION_DAYS=30

MAIL_MAILER=smtp
MAIL_FROM_ADDRESS=contato@luzicity.com.br
MAIL_FROM_NAME=LuziCity
