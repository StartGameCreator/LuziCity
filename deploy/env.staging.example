APP_NAME="LuziCity Staging"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.luzicity.com.br
APP_TIMEZONE=America/Sao_Paulo

LOG_CHANNEL=stack
LOG_STACK=daily,json
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=luzicity_staging
DB_USERNAME=luzicity_staging
DB_PASSWORD=

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1

FILESYSTEM_DISK=local
BACKUP_DISK=local
BACKUP_RETENTION_DAYS=7

MAIL_MAILER=log
