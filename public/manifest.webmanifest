        {"src": "/pwa/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
        {"src": "/pwa/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"},
        {"src": "/pwa/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any"}
    ],
    "categories": ["news", "magazines"],
    "lang": "pt-BR",
    "shortcuts": [
        {"name": "Buscar notícias", "short_name": "Buscar", "url": "/buscar", "icons": [{"src": "/pwa/icon-192.png", "sizes": "192x192", "type": "image/png"}]},
        {"name": "Rádio Web", "short_name": "Rádio", "url": "/radio", "icons": [{"src": "/pwa/icon-192.png", "sizes": "192x192", "type": "image/png"}]}
    ]
