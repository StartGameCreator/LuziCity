APP_NAME=Luzicity
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
# Em producao, use: LOG_STACK=daily,json
OBSERVABILITY_METRICS_ENABLED=true
OBSERVABILITY_SAMPLE_RATE=100
OBSERVABILITY_RETENTION_DAYS=30
OBSERVABILITY_SLOW_REQUEST_MS=1500
OBSERVABILITY_ERROR_RATE_WARNING=5
OBSERVABILITY_FAILED_JOBS_WARNING=1

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
BACKUP_DISK=local
BACKUP_PATH=backups
BACKUP_RETENTION_DAYS=30
BACKUP_INCLUDE_STORAGE=true
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids
DB_QUEUE_RETRY_AFTER=900
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=900
REDIS_QUEUE_BLOCK_FOR=5

CACHE_STORE=database
CACHE_PREFIX=
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default
LUZICITY_HOME_CACHE_TTL=5
LUZICITY_PUBLIC_CACHE_TTL=60

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

LUZICITY_BACKGROUND_IMAGE=
LUZICITY_BACKGROUND_OPACITY=0.34
LUZICITY_FACEBOOK_URL=
LUZICITY_INSTAGRAM_URL=
LUZICITY_TIKTOK_URL=
LUZICITY_YOUTUBE_URL=
LUZICITY_KWAI_URL=
LUZICITY_RUMBLE_URL=
LUZICITY_DLIVE_URL=
LUZICITY_SHOP_URL=
LUZICITY_GOOGLE_ADS_CLIENT=
LUZICITY_GOOGLE_AD_HOME_TOP=
LUZICITY_GOOGLE_AD_HOME_AFTER_HERO=
LUZICITY_GOOGLE_AD_HOME_BEFORE_LATEST=
LUZICITY_GOOGLE_AD_HOME_AFTER_LATEST=
LUZICITY_GOOGLE_AD_HOME_BEFORE_TOPICS=
LUZICITY_GOOGLE_AD_HOME_FOOTER=
LUZICITY_GOOGLE_AD_RADIO_HERO_1=
LUZICITY_GOOGLE_AD_RADIO_HERO_2=
LUZICITY_GOOGLE_AD_RADIO_HERO_3=
LUZICITY_GOOGLE_AD_RADIO_HERO_4=
LUZICITY_META_PIXEL_ID=
LUZICITY_TIKTOK_PIXEL_ID=

# Motor nativo de radio (AzuraCast)
# Local: http://127.0.0.1:8080
# Producao: https://azuracast.luzicity.com.br
AZURACAST_ENABLED=false
AZURACAST_BASE_URL=http://127.0.0.1:8080
AZURACAST_API_KEY=
AZURACAST_STATION_ID=
AZURACAST_STATION_SHORTCODE=
AZURACAST_TIMEOUT=10
AZURACAST_VERIFY_SSL=false
AZURACAST_CACHE_SECONDS=10
LUZICITY_AI_PROVIDER=chatgpt
LUZICITY_CHATGPT_MODEL=gpt-4o-mini
LUZICITY_GEMINI_MODEL=gemini-1.5-flash
LUZICITY_COPILOT_ENDPOINT=
OPENAI_API_KEY=
GEMINI_API_KEY=
COPILOT_API_KEY=

ADMIN_NAME="Administrador Luzicity"
ADMIN_EMAIL=
ADMIN_PASSWORD=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI="${APP_URL}/login/microsoft/callback"

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI="${APP_URL}/login/apple/callback"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/login/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/login/facebook/callback"

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI="${APP_URL}/login/instagram/callback"

TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI="${APP_URL}/login/tiktok/callback"

# Firebase Cloud Messaging (Fase 09)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=
# Caminho relativo para JSON ou conteúdo JSON em Base64
FIREBASE_SERVICE_ACCOUNT=storage/app/firebase-service-account.json
ANDROID_APP_PACKAGE=com.luzicity.app
ANDROID_SHA256_FINGERPRINTS=
IOS_TEAM_ID=
IOS_BUNDLE_ID=com.luzicity.app

# Mercado Pago Checkout Pro (cartões são processados fora da LuziCity)
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_SANDBOX=true

ANALYTICS_POLICY_VERSION=1.0
ANALYTICS_RETENTION_DAYS=395
